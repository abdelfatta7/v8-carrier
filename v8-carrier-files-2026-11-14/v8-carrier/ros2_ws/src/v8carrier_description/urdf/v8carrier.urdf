<robot name="v8carrier">
  <material name="shell"><color rgba="0.85 0.85 0.82 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="sensor"><color rgba="0.2 0.3 0.6 1"/></material>

  <!-- On the floor under the axle midpoint: the frame odometry and Nav2 use. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0000 0.0000 0.0400" rpy="0 0 0"/>
  </joint>

  <!-- Axle midpoint, wheel-radius above the floor. The body box is
       420 x 280 x 230 mm, its front 173 mm ahead of the axle. -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.0370 0.0000 0.0950" rpy="0 0 0"/>
      <geometry><box size="0.4200 0.2800 0.2300"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="-0.0370 0.0000 0.0950" rpy="0 0 0"/>
      <geometry><box size="0.4200 0.2800 0.2300"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0370 0.0000 0.0950" rpy="0 0 0"/>
      <mass value="4.490"/>
      <inertia ixx="0.04913" ixy="0" ixz="0" iyy="0.08580" iyz="0" izz="0.09534"/>
    </inertial>
  </link>

  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0.0000 0.0000"/>
      <geometry><cylinder radius="0.0400" length="0.0250"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0.0000 0.0000"/>
      <geometry><cylinder radius="0.0400" length="0.0250"/></geometry>
    </collision>
    <inertial>
      <mass value="0.080"/>
      <inertia ixx="0.000036" ixy="0" ixz="0" iyy="0.000064" iyz="0" izz="0.000036"/>
    </inertial>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0.0000 0.1665 0.0000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0.0000 0.0000"/>
      <geometry><cylinder radius="0.0400" length="0.0250"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0.0000 0.0000"/>
      <geometry><cylinder radius="0.0400" length="0.0250"/></geometry>
    </collision>
    <inertial>
      <mass value="0.080"/>
      <inertia ixx="0.000036" ixy="0" ixz="0" iyy="0.000064" iyz="0" izz="0.000036"/>
    </inertial>
  </link>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.0000 -0.1665 0.0000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.0095"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.0095"/></geometry>
    </collision>
    <inertial>
      <mass value="0.030"/>
      <inertia ixx="0.0000011" ixy="0" ixz="0" iyy="0.0000011" iyz="0" izz="0.0000011"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.2120 0.0000 -0.0305" rpy="0 0 0"/>
  </joint>

  <!-- RPLIDAR C1 on the nose tower, 70 mm behind the front.
       The scan plane is 0.257 m above the floor (approximate until the tower is built). -->
  <link name="laser">
    <visual>
      <origin xyz="0.0000 0.0000 -0.0060" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0280" length="0.0420"/></geometry>
      <material name="sensor"/>
    </visual>
    <inertial>
      <mass value="0.110"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.1030 0.0000 0.2170" rpy="0 0 0"/>
  </joint>

  <!-- IMU in the electronics pod (right side). Mount the board with its x
       axis forward and z up, or fix the orientation here. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0000 -0.1060 0.0400" rpy="0 0 0"/>
  </joint>
